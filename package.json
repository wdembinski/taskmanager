{
  "name": "taskmanager",
  "version": "0.0.0",
  "description": "Workspace root for the Task Manager monorepo — apps/client (the Electron app, the version of record) plus the packages it shares with the cloud server and web client.",
  "private": true,
  "author": "Wojciech Dembinski",
  "homepage": "https://github.com/wdembinski/taskmanager",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run build --filter=./packages/* && vitest run",
    "test:watch": "turbo run build --filter=./packages/* && vitest",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"*.{json,md}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
