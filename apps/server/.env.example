# Local development configuration for @tm/server.
# Copy to .env and edit if you need to. These defaults match docker-compose.yml.
# NEVER commit a .env file with real secrets.

PORT=3100

# Database connection (MSSQL). Matches the root docker-compose.yml service.
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=Local_Dev_Password_123!
DB_NAME=taskmanager

# Bypasses auth on the /v1 mirror routes for local development, until the
# "Guard the cloud API with vipper.iam" phase wires the real guard. The server
# refuses to start if this is set alongside NODE_ENV=production — see
# src/config/devAuthGate.ts.
CLOUD_DEV_NO_AUTH=1

NODE_ENV=development
