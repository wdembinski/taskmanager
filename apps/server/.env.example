# Local development configuration for @tm/server.
# Copy to .env and edit if you need to. These defaults match docker-compose.yml.
# NEVER commit a .env file with real secrets.

PORT=3100

# Database connection (MSSQL). Matches the root docker-compose.yml service.
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=Local_Dev_Password_123!
DB_NAME=taskmanager

# Bypasses IamAuthGuard on the /v1 routes for local development — the real guard
# (src/iam/iamAuth.guard.ts) needs a running vipper.iam to talk to. The server
# refuses to start if this is set alongside NODE_ENV=production — see
# src/config/devAuthGate.ts.
CLOUD_DEV_NO_AUTH=1

NODE_ENV=development

# vipper.iam — required outside CLOUD_DEV_NO_AUTH=1 (see src/iam/iam.config.ts).
# `@vipper/iam-connector` itself didn't resolve (npm.vipper.network 401s without a registry
# token — see the root .npmrc), so src/iam/iam.client.ts talks to these two endpoints directly.
CLOUD_IAM_API_BASE=https://iam.vipper.network/api/v1
CLOUD_IAM_CLIENT_ID=
CLOUD_IAM_CLIENT_SECRET=

# Optional: read CLOUD_IAM_CLIENT_SECRET and DB_PASSWORD from Azure Key Vault at startup
# instead of the plain vars above — see src/config/secrets.ts. Leave unset for local dev.
AZURE_KEY_VAULT_URI=
