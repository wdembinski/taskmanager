{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["*.{css,js,map,gif,jpg,jpeg,png,svg,webp,woff,woff2,ico,webmanifest,json}"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ]
}
