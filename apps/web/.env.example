# Local development configuration for @tm/web. Copy to .env.local and edit if you need to.
# Vite only exposes vars prefixed VITE_ to client code (everything here is public — this is
# a browser bundle, so nothing secret belongs in this file; PKCE is what secures the sign-in,
# not a hidden client id).

# The @tm/server root this client polls (GET /v1/board) and posts commands to
# (POST /v1/commands). No trailing slash. Matches apps/server's PORT (.env.example).
VITE_CLOUD_API_BASE=http://localhost:3100

# vipper.iam — the OIDC issuer this client sends the user's browser to, and this web build's
# own registered PUBLIC client id (grants: authorization_code + refresh_token,
# token_endpoint_auth_method: none — see apps/client/src/main/iamConfig.ts, the desktop
# build's equivalent, registered as a separate client id from this one).
VITE_CLOUD_IAM_ISSUER=https://auth.vipper.network/oidc
VITE_CLOUD_IAM_CLIENT_ID=taskmanager-web
