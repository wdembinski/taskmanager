# Normalize line endings so the repo is consistent across Windows/macOS/Linux.
# We store text as LF in git (matching Prettier's endOfLine: "lf"), which avoids
# spurious "the whole file changed" diffs and Prettier/Git fighting over CRLF.
* text=auto eol=lf

# Binary files git should never touch.
*.png binary
*.ico binary
*.icns binary
