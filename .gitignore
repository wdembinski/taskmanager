# Dependencies
node_modules/

# Build output (electron-vite compiles here; electron-builder packages from here;
# tsup writes packages/*/dist; turbo caches task output/logs under .turbo)
out/
dist/
.turbo/
*.tsbuildinfo

# Local application data (SQLite database, transcripts, logs) — never commit
/data/
*.sqlite
*.sqlite-journal

# Headless verification work dirs (scripts/verify-*.mjs). Inside the repo because their
# bundles keep better-sqlite3 external and so need node_modules on the resolution path;
# removed on the way out, but `--keep` leaves one behind on purpose.
/.verify-*/

# Local environment files (NEVER commit real secrets)
.env
.env.local

# Editor / OS
.DS_Store
.vscode/
.idea/
*.log
